{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/feedback/**",
              "components/forms/**",
              "components/icons/**",
              "components/layout/**",
              "components/navigation/**",
              "components/player/**",
              "ui_kits/web-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:JetBrains Mono|Montserrat))/i]",
        "message": "Font not provided by the design system. Available: JetBrains Mono, Montserrat."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|block|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, block, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|filled|color|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, filled, color, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|shape|pressed|iconSize|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, shape, pressed, iconSize."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:ghost|surface|outline)$/]",
        "message": "<IconButton> variant must be one of 'ghost' | 'surface' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|square)$/]",
        "message": "<IconButton> shape must be one of 'circle' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|children|active|href|onClick|inset|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: icon, label, children, active, href, onClick, inset."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|flush|as|children|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, flush, as, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|onToggle|size|key|ref|className|style|children)$/]",
        "message": "<PlayButton> doesn't accept that prop. Declared props: playing, onToggle, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlayButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<PlayButton> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|min|max|step|onChange|label|valueText|disabled|className|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, min, max, step, onChange, label, valueText, disabled, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|message|variant|onDismiss|role|className|key|ref|className|style|children)$/]",
        "message": "<StatusMessage> doesn't accept that prop. Declared props: tone, title, message, variant, onDismiss, role, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|danger)$/]",
        "message": "<StatusMessage> tone must be one of 'success' | 'warning' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusMessage'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:inline|banner)$/]",
        "message": "<StatusMessage> variant must be one of 'inline' | 'banner'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SequencerTrack'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|color|steps|muted|key|ref|className|style|children)$/]",
        "message": "<SequencerTrack> doesn't accept that prop. Declared props: id, name, color, steps, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:pressed|onPressedChange|icon|size|children|key|ref|className|style|children)$/]",
        "message": "<ToggleButton> doesn't accept that prop. Declared props: pressed, onPressedChange, icon, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<ToggleButton> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|color|muted|onMuteToggle|compact|className|style|key|ref|className|style|children)$/]",
        "message": "<TrackHeader> doesn't accept that prop. Declared props: name, color, muted, onMuteToggle, compact, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportControls'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|onPlayToggle|onPrev|onNext|prevDisabled|nextDisabled|loop|onLoopToggle|size|spread|className|style|key|ref|className|style|children)$/]",
        "message": "<TransportControls> doesn't accept that prop. Declared props: playing, onPlayToggle, onPrev, onNext, prevDisabled, nextDisabled, loop, onLoopToggle, size, spread, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TransportControls'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<TransportControls> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='VolumeSlider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|muted|onMuteToggle|showIcon|label|width|disabled|className|key|ref|className|style|children)$/]",
        "message": "<VolumeSlider> doesn't accept that prop. Declared props: value, onChange, muted, onMuteToggle, showIcon, label, width, disabled, className."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
